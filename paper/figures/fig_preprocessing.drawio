<mxfile host="app.diagrams.net">
  <diagram name="Preprocessing-Pipeline" id="9c450041-aaa6-49b6-9fe4-601ba0f5c3e4">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1"
        fold="1" page="1" pageScale="1" pageWidth="1310" pageHeight="1410" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="INS-HDGS-CMT Preprocessing Pipeline" style="text;html=1;align=center;fontStyle=1;fontSize=24;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1260" height="40" as="geometry"/></mxCell><mxCell id="c3" value="EEG Signal Cleaning" style="swimlane;rounded=1;arcSize=4;fillColor=#EAF0FB;strokeColor=#2E5AAC;strokeWidth=2;startSize=34;fontColor=#FFFFFF;fontStyle=1;fontSize=14;swimlaneFillColor=#EAF0FB;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="610" height="518" as="geometry"/></mxCell><mxCell id="c4" value="" style="rounded=0;fillColor=#2E5AAC;strokeColor=none;" vertex="1" parent="c3"><mxGeometry x="0" y="0" width="610" height="34" as="geometry"/></mxCell><mxCell id="c5" value="EEG Signal Cleaning" style="text;html=1;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="c3"><mxGeometry x="0" y="0" width="610" height="34" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;1. Raw EEG&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#444&quot;&gt;24-channel montage (10-20 layout), native 300 Hz, per-subject LSL stream&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontColor=#2E5AAC;fontSize=12.5;html=1;whiteSpace=wrap;" vertex="1" parent="c3"><mxGeometry x="16" y="46" width="578" height="66" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;2. Bad-channel handling&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#444&quot;&gt;S01 only: 4 non-cortical channels dropped (X1, X2, X3, TRG); no scalp electrode removed for any subject&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontColor=#2E5AAC;fontSize=12.5;html=1;whiteSpace=wrap;" vertex="1" parent="c3"><mxGeometry x="16" y="124" width="578" height="66" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;3. Common-average reference&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#444&quot;&gt;subtract per-timepoint mean across each subject's remaining channel set (runs before harmonization -- see note)&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontColor=#2E5AAC;fontSize=12.5;html=1;whiteSpace=wrap;" vertex="1" parent="c3"><mxGeometry x="16" y="202" width="578" height="66" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;4. Band-pass filter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#444&quot;&gt;Butterworth order 4, filtfilt, 1-45 Hz&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontColor=#2E5AAC;fontSize=12.5;html=1;whiteSpace=wrap;" vertex="1" parent="c3"><mxGeometry x="16" y="280" width="578" height="66" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;5. Notch filter&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#444&quot;&gt;iirnotch + filtfilt, 50 Hz, Q = 30&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontColor=#2E5AAC;fontSize=12.5;html=1;whiteSpace=wrap;" vertex="1" parent="c3"><mxGeometry x="16" y="358" width="578" height="66" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;6. ICA artifact removal&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#444&quot;&gt;FastICA, 15 components, seed 42, max_iter 1000&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontColor=#2E5AAC;fontSize=12.5;html=1;whiteSpace=wrap;" vertex="1" parent="c3"><mxGeometry x="16" y="436" width="578" height="66" as="geometry"/></mxCell><mxCell id="c12" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3A3A3A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="c3" source="c6" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3A3A3A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="c3" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c14" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3A3A3A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="c3" source="c8" target="c9"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c15" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3A3A3A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="c3" source="c9" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3A3A3A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="c3" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c17" value="Eye-Tracking Signal Cleaning" style="swimlane;rounded=1;arcSize=4;fillColor=#EEF6EA;strokeColor=#3C7A2E;strokeWidth=2;startSize=34;fontColor=#FFFFFF;fontStyle=1;fontSize=14;swimlaneFillColor=#EEF6EA;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="680" y="60" width="610" height="518" as="geometry"/></mxCell><mxCell id="c18" value="" style="rounded=0;fillColor=#3C7A2E;strokeColor=none;" vertex="1" parent="c17"><mxGeometry x="0" y="0" width="610" height="34" as="geometry"/></mxCell><mxCell id="c19" value="Eye-Tracking Signal Cleaning" style="text;html=1;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="c17"><mxGeometry x="0" y="0" width="610" height="34" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;1. Raw eye-tracking&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#444&quot;&gt;6-channel binocular stream (L/R gaze x, y + pupil), native 120 Hz&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontColor=#3C7A2E;fontSize=12.5;html=1;whiteSpace=wrap;" vertex="1" parent="c17"><mxGeometry x="16" y="46" width="578" height="66" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;2. Blink / dropout gap-fill&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#444&quot;&gt;linear interpolation, max gap 12 samples (~100 ms)&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontColor=#3C7A2E;fontSize=12.5;html=1;whiteSpace=wrap;" vertex="1" parent="c17"><mxGeometry x="16" y="124" width="578" height="66" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;3. Smoothing&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#444&quot;&gt;centered rolling mean, window = 5&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontColor=#3C7A2E;fontSize=12.5;html=1;whiteSpace=wrap;" vertex="1" parent="c17"><mxGeometry x="16" y="202" width="578" height="66" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;4. Fixation detection&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#444&quot;&gt;velocity threshold 80 px/s, min duration 12 samples, binocular fusion&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontColor=#3C7A2E;fontSize=12.5;html=1;whiteSpace=wrap;" vertex="1" parent="c17"><mxGeometry x="16" y="280" width="578" height="66" as="geometry"/></mxCell><mxCell id="c24" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3A3A3A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="c17" source="c20" target="c21"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3A3A3A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="c17" source="c21" target="c22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3A3A3A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="c17" source="c22" target="c23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Temporal alignment&lt;/b&gt; -- both streams trimmed to the shared overlap window using common stimulus-onset markers; each stream is then epoched independently at its OWN native rate (300 Hz EEG / 120 Hz eye-tracking) -- neither is resampled to the other's rate" style="rounded=1;arcSize=8;fillColor=#F1ECF8;strokeColor=#6A4C93;strokeWidth=2;html=1;verticalAlign=middle;align=center;fontColor=#6A4C93;fontStyle=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="608" width="1270" height="70" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2E5AAC;strokeWidth=2;endArrow=block;endFill=1;exitX=0.25;exitY=1;entryX=0.25;entryY=0;" edge="1" parent="1" source="c11" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c29" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3C7A2E;strokeWidth=2;endArrow=block;endFill=1;exitX=0.75;exitY=1;entryX=0.75;entryY=0;" edge="1" parent="1" source="c23" target="c27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c30" value="EEG Epoching -&gt; Graph + Band-Power Features" style="swimlane;rounded=1;arcSize=4;fillColor=#EAF0FB;strokeColor=#2E5AAC;strokeWidth=2;startSize=34;fontColor=#FFFFFF;fontStyle=1;fontSize=14;swimlaneFillColor=#EAF0FB;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="20" y="708" width="610" height="386" as="geometry"/></mxCell><mxCell id="c31" value="" style="rounded=0;fillColor=#2E5AAC;strokeColor=none;" vertex="1" parent="c30"><mxGeometry x="0" y="0" width="610" height="34" as="geometry"/></mxCell><mxCell id="c32" value="EEG Epoching -&gt; Graph + Band-Power Features" style="text;html=1;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="c30"><mxGeometry x="0" y="0" width="610" height="34" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;7. Epoching&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#444&quot;&gt;5.0 s window from stimulus onset -&gt; 1500 samples/epoch&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontColor=#2E5AAC;fontSize=12.5;html=1;whiteSpace=wrap;" vertex="1" parent="c30"><mxGeometry x="16" y="46" width="578" height="66" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;8. Channel harmonization&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#444&quot;&gt;zero-fill any missing position back to 24-wide, then drop the 5 non-cortical channels (X1, X2, X3, A2, TRG) -&gt; 19 canonical scalp channels&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontColor=#2E5AAC;fontSize=12.5;html=1;whiteSpace=wrap;" vertex="1" parent="c30"><mxGeometry x="16" y="124" width="578" height="66" as="geometry"/></mxCell><mxCell id="c35" value="&lt;b&gt;9. Per-subject z-score normalization&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#444&quot;&gt;fit without labels (subject-level, transductive)&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontColor=#2E5AAC;fontSize=12.5;html=1;whiteSpace=wrap;" vertex="1" parent="c30"><mxGeometry x="16" y="202" width="578" height="66" as="geometry"/></mxCell><mxCell id="c36" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3A3A3A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="c30" source="c33" target="c34"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c37" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3A3A3A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="c30" source="c34" target="c35"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c38" value="&lt;b&gt;10. Dynamic graph construction&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#444&quot;&gt;ten 0.5 s sub-windows/epoch; Pearson correlation r_ij(t) per window -&gt; edges (threshold tau = 0.30)&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontColor=#2E5AAC;fontSize=12.5;html=1;whiteSpace=wrap;" vertex="1" parent="c30"><mxGeometry x="16" y="280" width="282.0" height="90" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;10'. Band-power extraction&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#444&quot;&gt;5-band relative power per 0.5 s sub-window -- independent of the graph, same features feed both branches&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontColor=#2E5AAC;fontSize=12.5;html=1;whiteSpace=wrap;" vertex="1" parent="c30"><mxGeometry x="312.0" y="280" width="282.0" height="90" as="geometry"/></mxCell><mxCell id="c40" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3A3A3A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="c30" source="c35" target="c38"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c41" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3A3A3A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="c30" source="c35" target="c39"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c42" value="Eye-Tracking Epoching -&gt; Model Inputs" style="swimlane;rounded=1;arcSize=4;fillColor=#EEF6EA;strokeColor=#3C7A2E;strokeWidth=2;startSize=34;fontColor=#FFFFFF;fontStyle=1;fontSize=14;swimlaneFillColor=#EEF6EA;swimlaneLine=0;" vertex="1" parent="1"><mxGeometry x="680" y="708" width="610" height="386" as="geometry"/></mxCell><mxCell id="c43" value="" style="rounded=0;fillColor=#3C7A2E;strokeColor=none;" vertex="1" parent="c42"><mxGeometry x="0" y="0" width="610" height="34" as="geometry"/></mxCell><mxCell id="c44" value="Eye-Tracking Epoching -&gt; Model Inputs" style="text;html=1;fontColor=#FFFFFF;fontStyle=1;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="c42"><mxGeometry x="0" y="0" width="610" height="34" as="geometry"/></mxCell><mxCell id="c45" value="&lt;b&gt;5. Epoching&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#444&quot;&gt;5.0 s window from stimulus onset -&gt; 600 samples/epoch&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontColor=#3C7A2E;fontSize=12.5;html=1;whiteSpace=wrap;" vertex="1" parent="c42"><mxGeometry x="16" y="46" width="578" height="66" as="geometry"/></mxCell><mxCell id="c46" value="&lt;b&gt;6. Channel selection&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#444&quot;&gt;truncate to 3 channels (gaze x, gaze y, pupil) for the Transformer attention encoder&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontColor=#3C7A2E;fontSize=12.5;html=1;whiteSpace=wrap;" vertex="1" parent="c42"><mxGeometry x="16" y="280" width="282.0" height="90" as="geometry"/></mxCell><mxCell id="c47" value="&lt;b&gt;7. ROI dwell vector&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:10.5px;color:#444&quot;&gt;5x2 spatial grid occupancy histogram -&gt; 10-dim ROI vector; modulates EEG graph attention in the full model only&lt;/span&gt;" style="rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#BBBBBB;align=left;verticalAlign=middle;spacingLeft=8;spacingRight=6;fontColor=#3C7A2E;fontSize=12.5;html=1;whiteSpace=wrap;" vertex="1" parent="c42"><mxGeometry x="312.0" y="280" width="282.0" height="90" as="geometry"/></mxCell><mxCell id="c48" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3A3A3A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="c42" source="c45" target="c46"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c49" value="" style="edgeStyle=none;rounded=0;html=1;strokeColor=#3A3A3A;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="c42" source="c45" target="c47"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c50" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2E5AAC;strokeWidth=2;endArrow=block;endFill=1;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c27" target="c33"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c51" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3C7A2E;strokeWidth=2;endArrow=block;endFill=1;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c27" target="c45"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c52" value="&lt;div style='text-align:center'&gt;&lt;b style='color:#B23A48'&gt;Feeds Fig. 2 -- INS-HDGS-CMT Architecture&lt;/b&gt;&lt;br/&gt;&lt;span style='color:#2E5AAC'&gt;Graph -&amp;gt; Panel A.2 (DynamicGAT)  &amp;nbsp;|&amp;nbsp;  Band-power features -&amp;gt; Panel A.3&amp;#8242; (LIF Spiking Encoder), independently of the graph&lt;/span&gt;&lt;br/&gt;&lt;span style='color:#3C7A2E'&gt;3-ch gaze/pupil -&amp;gt; Panel B.1 (Transformer)  &amp;nbsp;|&amp;nbsp;  ROI vector -&amp;gt; dashed link into Panel A.2 (full model only)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#FBE7E9;strokeColor=#B23A48;strokeWidth=2;html=1;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="1124" width="1270" height="100" as="geometry"/></mxCell><mxCell id="c53" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2E5AAC;strokeWidth=2;endArrow=block;endFill=1;rounded=0;exitX=0.5;exitY=1;entryX=0.18;entryY=0;" edge="1" parent="1" source="c38" target="c52"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c54" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#2E5AAC;strokeWidth=2;endArrow=block;endFill=1;rounded=0;exitX=0.5;exitY=1;entryX=0.4;entryY=0;" edge="1" parent="1" source="c39" target="c52"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c55" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3C7A2E;strokeWidth=2;endArrow=block;endFill=1;rounded=0;exitX=0.5;exitY=1;entryX=0.6;entryY=0;" edge="1" parent="1" source="c46" target="c52"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c56" value="" style="edgeStyle=orthogonalEdgeStyle;html=1;strokeColor=#3C7A2E;strokeWidth=2;endArrow=block;endFill=1;rounded=0;exitX=0.5;exitY=1;entryX=0.82;entryY=0;" edge="1" parent="1" source="c47" target="c52"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c57" value="&lt;div style='text-align:center'&gt;&lt;b style='color:#5C6670'&gt;Production label: engagement_phase3d (supervisory target ONLY -- not a model input, not part of the forward pass above)&lt;/b&gt;&lt;br/&gt;&lt;span style='color:#444'&gt;Computed from the same epoched streams: mean(P3, C3, F3, Fz) -&amp;gt; Welch band power (theta 4-8, alpha 8-13, beta 13-30 Hz) + theta/beta ratio + P3-Fz asymmetry, combined with epoched gaze-derived terms -&amp;gt; HIGH / LOW label&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=8;fillColor=#EEF0F2;strokeColor=#5C6670;strokeWidth=2;html=1;verticalAlign=middle;dashed=1;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="1254" width="1270" height="90" as="geometry"/></mxCell><mxCell id="c58" value="Note: common-average referencing (EEG step 3) and ICA (step 6) run on each subject&#8217;s own post-bad-channel-removal set (24 channels for every subject except S01); the 5 non-cortical channels are zero-filled then dropped only at harmonization (step 8), after signal preprocessing -- not before. Channel selection and the ROI dwell vector are independent, parallel outputs of eye-tracking epoching, not a sequential chain." style="text;html=1;align=center;fontStyle=2;fontSize=11;fontColor=#444444;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="1354" width="1270" height="40" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
