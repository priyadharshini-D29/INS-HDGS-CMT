# ---------------------------------------------------------------------------
# INS-HDGS-CMT — .gitignore
# ---------------------------------------------------------------------------

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.installed.cfg
*.egg

# ---- Virtual environments ----
.venv/
venv/
env/
ENV/
.conda/

# ---- Jupyter ----
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ---- Testing / linting caches ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ---- OS ----
.DS_Store
Thumbs.db
desktop.ini

# ---- Editors ----
.idea/
.vscode/
*.swp
*~

# ---------------------------------------------------------------------------
# Data — NEVER commit the raw/proprietary NeuMa dataset
# ---------------------------------------------------------------------------
datasets/raw/
datasets/**/*.xdf
datasets/**/*.xlsx
datasets/**/*.tif
data/
DataSource/
*.xdf

# ---------------------------------------------------------------------------
# Generated / transient outputs (regenerated by the pipeline)
# ---------------------------------------------------------------------------
output/
src/**/output/
runs/
wandb/
*.tmp

# Cached intermediate tensors / graphs
*.pt.cache
*.npz.cache
cache_graphs/

# ---------------------------------------------------------------------------
# Kept intentionally (tracked via Git LFS, see .gitattributes):
#   checkpoints/  results/  figures/  paper/*.pdf  logs/*.log
# Do NOT ignore those — they are release artifacts.
# ---------------------------------------------------------------------------

# LaTeX build junk (keep the .pdf and .tex, drop the rest)
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.out
paper/*.toc
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk
